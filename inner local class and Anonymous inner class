class Calculator
{
    public void calculate(int a,int b)
    {
        class Operation
        {
            public void add()
            {
                int addd=a+b;
                System.out.println("Addition is "+addd);
            }
            public void multiply()
            {
                int mul=a*b;
                System.out.println("Multiplication is "+mul);
            }
        }
        Operation o=new Operation();
        o.add();
        o.multiply();
    }
}


