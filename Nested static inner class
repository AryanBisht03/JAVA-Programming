class University
{
    static String universityName="GEHU";
    static String location="Dehradun";
    public University()
    {
     this("unknown");   
    }
    public University(String universityName)
    {
        this(universityName,"unknown");
    }
    public University(String universityName,String location)
    {
        this.universityName=universityName;
        this.location=location;
    }
    static class Department
    {
        String DepartmentName;
        String hodName;
        public Department()
        {
          this("unknown");  
        }
        public Department(String DepartmentName)
        {
            this(DepartmentName,"unknown");
        } 
        public Department(String DepartmentName,String hodName)
        {
            this.DepartmentName=DepartmentName;
            this.hodName=hodName;
        }
        
        public void displayDepartment()
        {
            System.out.println("University Name : "+universityName);
            System.out.println("Location : "+location);
            System.out.println("Department Name : "+DepartmentName);
            System.out.println("Hod Name : "+hodName);
        }
    }
}

